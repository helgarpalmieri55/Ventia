# Ventia — production environment for docker/compose.prod.yaml.
#
#   cp .env.production.example .env
#   # fill in every value marked GENERATE or SET, then:
#   docker compose --env-file .env -f docker/compose.prod.yaml up -d --build
#
# This file is the DEPLOYMENT view: what each variable must be for the compose
# stack to work, and what breaks when it is wrong. It deliberately does not
# repeat the reasoning behind the variables themselves — `.env.example` at the
# repo root argues each one at length (why PLATFORM_ADMIN_EMAILS fails closed,
# why the rate-limit defaults are generous, why WhatsApp credentials are per
# tenant and not here), and `docs/deploying.md` covers the operational side.
# Read those; this is the checklist.
#
# `.env` is gitignored. Nothing in this file belongs in the compose file, and
# nothing in it should ever be committed.


# =============================================================================
# 1. Secrets with no safe default — GENERATE ALL FIVE BEFORE FIRST BOOT
# =============================================================================
# There is no dev fallback for any of these and no value here you can leave.

# Signs every session cookie and the impersonation grant. Wrong or changed:
# every logged-in merchant and operator is logged out at once.
#   openssl rand -base64 32
AUTH_SECRET=

# AES-256-GCM key for per-tenant payment-gateway AND WhatsApp credentials at
# rest. Must base64-decode to exactly 32 bytes or the API refuses to boot.
# LOSING IT IS UNRECOVERABLE: every merchant's stored gateway keys become
# undecryptable and each of them has to re-enter them by hand. Back it up
# somewhere that is neither the database host nor the database backup.
#   openssl rand -base64 32
PAYMENTS_ENCRYPTION_KEY=

# Postgres superuser for the stack's own database container. Used by the
# postgres image on FIRST BOOT ONLY — changing it later does not change the
# role, it just makes DATABASE_URL below wrong and every query fail.
# The password also appears inside DATABASE_URL; the two must agree.
POSTGRES_USER=ventia
POSTGRES_PASSWORD=
POSTGRES_DB=ventia

# MinIO root credentials, and therefore the S3 credentials the API signs
# uploads with. Wrong: every product-image upload fails with SignatureDoesNot
# Match, and the storefront shows broken images for anything already stored.
# Like Postgres, these are baked in on first boot of the volume.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=


# =============================================================================
# 2. Connection strings — must match section 1 and the compose service names
# =============================================================================
# Hosts are compose SERVICE NAMES, not localhost. Nothing in this stack
# publishes a port to the host, so `localhost` here resolves to the container
# itself and every connection is refused.

# Same user/password/db as POSTGRES_* above. Wrong credentials: the migration
# job fails, and because the API depends on it with
# service_completed_successfully, the API never starts at all.
DATABASE_URL=postgresql://ventia:CHANGE_ME@postgres:5432/ventia

# BullMQ queues and rate-limit counters. Wrong: the API boots and then throws
# on the first request that touches a limiter — i.e. on auth and checkout.
REDIS_URL=redis://redis:6379


# =============================================================================
# 3. Public hostnames
# =============================================================================
# These are what appears in emails, redirects and cookies. Every one of them
# must be a hostname Caddy actually serves; a wrong value produces links that
# 404 for the recipient rather than an error you would see.

# The apex every tenant subdomain hangs off, and what the tenant resolver
# strips to find a slug. Read by BOTH the API and Caddy (docker/Caddyfile.prod
# substitutes it into every site block), so it is the one variable where a
# mismatch would be invisible: wrong here and every storefront resolves to
# "unknown tenant" while Caddy still happily serves the hostname.
PLATFORM_ROOT_DOMAIN=ventia.co

# The public IPv4 this server answers on. Shown in the admin panel to a
# merchant whose custom domain is a bare apex (`mitienda.com`), because most
# DNS providers refuse a CNAME at the zone root and an A record is the only way
# to point one here. Merchants using a subdomain (`tienda.mitienda.com`) never
# need it — they CNAME to their `${slug}.${PLATFORM_ROOT_DOMAIN}` address.
# UNSET: the panel tells those merchants to contact you instead. That is a
# deliberate fallback and not a broken state — leave it unset rather than
# guessing, because an apex A record pointing at an address this server does
# not answer on takes the merchant's store off the internet entirely.
PLATFORM_APEX_IP=

# Where Let's Encrypt sends certificate-expiry warnings. Read by Caddy only.
# UNSET: Caddy cannot accept the ACME terms non-interactively and refuses to
# start, so nothing is served at all — including the storefronts.
ACME_EMAIL=ops@ventia.co

# Public origin of the API. Used as better-auth's baseURL, so a mismatch with
# the address the browser actually used makes session cookies fail their
# origin check and login silently never sticks.
API_URL=https://api.ventia.co

# Public origin of the API for WhatsApp webhook registration only — the URL
# handed to Meta. Wrong: Meta's webhook verification handshake fails and no
# inbound message is ever delivered.
API_PUBLIC_URL=https://api.ventia.co

# Public origin of the merchant console. Appears in every staff invite,
# password reset and agent-escalation email, and in better-auth's trusted
# origins. Wrong: those links go nowhere and cross-origin auth calls are
# rejected.
ADMIN_URL=https://admin.ventia.co

# Shared secret for the storefront's on-demand revalidation route. Wrong: the
# API's revalidation calls are rejected and storefront pages keep serving stale
# catalogue data until the next deploy.
#   openssl rand -hex 32
REVALIDATE_SECRET=

# Overrides http/https inference for tenant storefront redirect URLs. LEAVE
# UNSET on a real domain — inference already gives https. Set it only for a
# staging host served over plain HTTP; anything other than `http`/`https`
# throws at boot.
# STOREFRONT_PUBLIC_SCHEME=https


# =============================================================================
# 4. Object storage
# =============================================================================
# S3_ENDPOINT and STOREFRONT_INTERNAL_URL are NOT here: compose.prod.yaml sets
# both, because they name compose services rather than deployment facts.

# Bucket name. Created by the minio-init job on first `up`. Changing it later
# without creating the new bucket makes every upload fail.
S3_BUCKET=ventia

# Must equal MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above. They are separate
# variables because a deployment could point at a real S3; in this stack they
# are the same two values, and a mismatch fails every upload.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# The URL a SHOPPER'S BROWSER uses to fetch product images — so it must be
# publicly reachable and served by Caddy, not the internal minio:9000 address.
# Wrong: every product image on every storefront is broken, while uploads keep
# succeeding, so the failure looks like a CDN problem rather than a config one.
# docker/Caddyfile.prod serves this from `cdn.${PLATFORM_ROOT_DOMAIN}` (GET and
# HEAD only), so the shape below is the one that works with the shipped edge
# config: https://cdn.<root-domain>/<bucket>.
S3_PUBLIC_URL=https://cdn.ventia.co/ventia

# Optional. Only needed if you expose the MinIO console behind Caddy; leaving
# it empty is correct for a stack whose console is not published (this one).
MINIO_BROWSER_REDIRECT_URL=


# =============================================================================
# 5. Platform operator access
# =============================================================================
# UNSET (or empty — this one accepts empty) DENIES EVERYONE, including you.
# That is the intended failure direction.
# Listing an address is necessary but not sufficient: the user's email must be
# verified AND `User.isPlatformAdmin` must be true, which no code path in the
# product writes. After the operator signs up and verifies:
#   UPDATE "User" SET "isPlatformAdmin" = true WHERE email = 'ops@ventia.co';
# See docs/deploying.md §3.
PLATFORM_ADMIN_EMAILS=


# =============================================================================
# 6. Outbound services
# =============================================================================

# Transactional email. COMMENT IT OUT if you have no key yet — do not leave it
# assigned-but-empty. The schema is `.min(1).optional()`, so absent is
# accepted and empty is a hard boot failure:
#   Invalid environment: RESEND_API_KEY: String must contain at least 1
#   character(s)
# (Observed: the first `compose up` of this stack crash-looped the API on
# exactly this, with the migration already applied.) The same applies to every
# `VAR=` line in this file — an empty value is not the same as an unset one.
#
# Genuinely unset means no email is sent AT ALL: no order confirmations, no
# staff invites, no email verification — which also means no operator can ever
# satisfy the verified-email half of section 5.
# RESEND_API_KEY=

# From address on every email. Must be on a domain verified in Resend, or
# Resend rejects each send.
RESEND_FROM_EMAIL=pedidos@ventia.co

# The AI sales agent, on both the web widget and WhatsApp. UNSET is a supported
# state: the API boots and sells normally, and only agent requests fail — the
# client is constructed lazily on purpose. Read by the Anthropic SDK rather
# than by loadEnv(), so unlike RESEND_API_KEY an empty value here is harmless.
ANTHROPIC_API_KEY=

# =============================================================================
# Model pricing, and the OPS feed
# =============================================================================
# What one million tokens costs YOU, in US dollars, at the rates your account
# actually pays. Copy them from your provider's pricing page (or your
# contract) — they are per MILLION tokens, which is the unit providers publish,
# so no conversion is needed.
#
# BOTH or NEITHER. Setting only one would price the other side at zero and
# report a margin that does not exist, so a half-configured pair is treated as
# unconfigured.
#
# UNSET: cost is reported as `null` everywhere — the operator console and the
# OPS feed both say "not configured" instead of drawing a zero. That is
# deliberate: the column this replaced (`costCents`) was never written by
# anything, and every screen that read it reported every store as free, which
# looked exactly like a working answer. There is no default here for the same
# reason.
AGENT_PRICE_INPUT_USD_PER_MTOK=
AGENT_PRICE_OUTPUT_USD_PER_MTOK=

# The two prompt-cache rates, if you know them. OPTIONAL, and an unset one
# falls back to the BASE INPUT price above — which can only OVERSTATE cost,
# since a cache read is never dearer than a fresh read. That direction is
# deliberate: set nothing and your margin figure is conservative; set the real
# rates and it is exact. Neither ever tells you that you are more profitable
# than you are, which is why there is no built-in discount ratio here.
AGENT_PRICE_CACHE_WRITE_USD_PER_MTOK=
AGENT_PRICE_CACHE_READ_USD_PER_MTOK=

# Which model answers shoppers. UNSET uses the model of record in
# services/api/src/agent/agent.service.ts.
#
# This is the single largest lever on what the product costs to run, and it is
# an env var so you can try a cheaper tier, watch the cost in the OPS feed, and
# move back without a deploy. Before you leave a change in place, run
# `test/agent-evals.test.ts` against a real key on both tiers and compare —
# catalogue lookup and cart building very likely do not need the top tier, but
# that is a question about how the agent talks to your merchants' customers,
# and the evals are the only honest way to answer it.
AGENT_MODEL=

# Shared secret the external OPS application presents as
# `Authorization: Bearer <token>` on GET /v1/ops/metrics, and the key the
# pushed snapshots are HMAC-signed with. Generate with:
#   openssl rand -hex 32
# Minimum 32 characters — shorter is refused, because this one credential
# reaches every store's cost and health in a single response.
# UNSET: the feed is OFF. The endpoint answers 503 and the push never starts.
# That is the safe direction: an outage is visible, a wide-open metrics
# endpoint is not.
OPS_METRICS_TOKEN=

# Where to POST each snapshot. Must be an absolute http(s) URL.
# UNSET: no push, and the pull endpoint still works on its own. Set it when you
# want the ABSENCE of data to be a signal — a polled endpoint that stops being
# polled looks identical to one that stopped answering.
# Requires OPS_METRICS_TOKEN: an unsigned feed the receiver cannot authenticate
# is worse than no feed, because it gets trusted anyway.
OPS_PUSH_URL=

# How often to push, in seconds. Default 60, floor 10.
OPS_PUSH_INTERVAL_SECONDS=

# Falls back to PAYMENTS_ENCRYPTION_KEY when unset, which is right for a
# single-key deployment. Set it separately only if you rotate the payments key
# on a different schedule — rotating whichever one applies invalidates every
# published-but-unverified custom-domain token.
# DOMAIN_VERIFICATION_SECRET=


# =============================================================================
# 7. Policy knobs — defaults are deliberate, change only with intent
# =============================================================================
# All optional. Every one of them falls back to a sane default when unset, and
# to the same default when set to something unparseable, rather than to zero.

# API listen port inside the container. Caddy and the healthcheck both derive
# from it; changing it means changing the Caddyfile too.
# API_PORT=4000

# Months of shopper<->agent conversation history kept before the nightly purge.
# This is a Ley 1581 retention obligation, not a preference (docs/SPEC.md §9).
# AGENT_RETENTION_MONTHS=12

# Days past a merchant's paid-until date before their store is auto-suspended.
# The warning email fires at N-3. Policy, not a technical constant.
# SUBSCRIPTION_GRACE_DAYS=7

# Requests per minute per key. Colombian mobile traffic is heavily NATed, so
# these are deliberately generous — lowering them rejects real shoppers.
# RATE_LIMIT_AUTH_PER_MINUTE=60
# RATE_LIMIT_CHECKOUT_PER_MINUTE=60
# RATE_LIMIT_AGENT_PER_MINUTE=30
# RATE_LIMIT_WEBHOOKS_PER_MINUTE=600
# Shopper accounts (/v1/storefront/account). Its own bucket, NOT shared with
# AUTH above — that one is merchant login, and a busy storefront exhausting a
# shared budget would lock a merchant out of their own panel.
# Tighter than the rest on purpose: a shopper signs in once and stays signed in
# for a month, while every attempt costs a real scrypt hash and the
# magic-link / password-reset routes send mail you pay for, to an address the
# requester does not have to own.
# RATE_LIMIT_SHOPPER_AUTH_PER_MINUTE=20


# =============================================================================
# 8. Error reporting — all optional, all cleanly off when unset
# =============================================================================
# No DSN means reporting is OFF, not broken: the SDK is not even imported. A
# malformed DSN logs one line and stays off — a typo here must never take a
# storefront down.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0


# =============================================================================
# Not here on purpose
# =============================================================================
# - Payment gateway credentials (Wompi / Mercado Pago / ePayco): PER TENANT,
#   entered by each merchant in Configuración → Pagos, encrypted at rest with
#   PAYMENTS_ENCRYPTION_KEY. There is no platform-level gateway key.
# - WhatsApp access token / app secret / verify token: PER TENANT, same
#   mechanism. The one platform-level decision (which Meta app the numbers live
#   under) is made in the Meta dashboard — docs/deploying-whatsapp.md.
# - Backup destination (BACKUP_S3_*): read by scripts/backup-upload.mjs from
#   the host cron environment, not by any container in this stack.
#   docs/deploying.md §7.
