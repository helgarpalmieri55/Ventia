# AES-256-GCM key for encrypting payment-provider credentials (e.g. Wompi's
# public/private keys) at rest. Must be a base64-encoded 32-byte key.
# Generate one with: openssl rand -base64 32
PAYMENTS_ENCRYPTION_KEY=
# Public, browser-reachable base URL of the storefront, used by the payment
# adapters that send a shopper's browser back to a FIRST-PARTY route:
# ePayco's `/pago/epayco` widget bridge page and Wompi's
# `/pago/wompi-retorno/{orderNumber}` return-capture page.
#
# PROVISIONAL AND MULTI-TENANT-WRONG BY CONSTRUCTION — read
# packages/payments/src/storefront-base.ts's doc comment before relying on
# it: this is ONE global URL, so in a deployment where more than one tenant
# uses ePayco or Wompi, every tenant's shoppers get redirected to whichever
# single storefront base is configured here. Production needs the real
# per-request tenant domain threaded through the adapters instead.
# (Renamed in P3c from the ePayco-specific EPAYCO_STOREFRONT_BASE_URL; same
# behavior, same http://localhost:3000 default when unset.)
PAYMENTS_STOREFRONT_BASE_URL=http://localhost:3000
