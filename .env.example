DATABASE_URL=postgresql://ventia:ventia@localhost:5432/ventia
REDIS_URL=redis://localhost:6379
AUTH_SECRET=dev-secret-change-me
API_PORT=4000
API_URL=http://api.ventia.localhost
API_INTERNAL_URL=http://localhost:4000
ADMIN_URL=http://admin.ventia.localhost
PLATFORM_ROOT_DOMAIN=ventia.localhost
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ventia
S3_SECRET_KEY=ventia-secret
S3_BUCKET=ventia
S3_PUBLIC_URL=http://localhost:9000/ventia
REVALIDATE_SECRET=dev-revalidate-secret
STOREFRONT_INTERNAL_URL=http://localhost:3000
# RESEND_API_KEY=
RESEND_FROM_EMAIL=pedidos@ventia.localhost
# AES-256-GCM key for encrypting payment-provider credentials (e.g. Wompi's
# public/private keys) at rest. Must be a base64-encoded 32-byte key.
# Generate one with: openssl rand -base64 32
PAYMENTS_ENCRYPTION_KEY=
# PAYMENTS_STOREFRONT_BASE_URL was REMOVED. It was one global URL used by the
# payment adapters that send a shopper's browser back to a first-party route
# (ePayco's /pago/epayco bridge page and /pago/epayco-retorno response page,
# Wompi's /pago/wompi-retorno return-capture page), which meant every tenant's
# shoppers were redirected to whichever single storefront it named. Those URLs
# are now built per request from the tenant's own domain (the TenantDomain row
# the request resolved through) — see packages/payments/src/storefront-base.ts.
# A leftover value in a local .env is simply ignored; nothing reads it.
#
# Optional override for the SCHEME half of those per-tenant URLs. Leave unset
# and it is inferred: localhost / *.localhost / *.local / *.test get `http`
# (this repo's dev stack — Caddy serves http://*.ventia.localhost), every other
# (i.e. real, publicly registrable) domain gets `https`. Set it only for a
# deployment that inference gets wrong, e.g. a staging host served over plain
# HTTP. Must be exactly `http` or `https`; anything else throws rather than
# being silently ignored. See services/api/src/tenants/tenant-public-url.ts.
# STOREFRONT_PUBLIC_SCHEME=https

# --- Rate limiting (docs/SPEC.md §9) -----------------------------------------
# Requests permitted per minute, per key, for each limited surface. All three
# are OPTIONAL — the defaults in services/api/src/common/rate-limit.ts apply
# when unset, and a non-integer or non-positive value falls back to the default
# rather than disabling limiting.
#
# `auth` and `checkout` are keyed per client IP; `webhooks` is keyed per
# tenant+provider (gateway callbacks all arrive from a few of the gateway's own
# addresses, so an IP key would let one busy store throttle every other store's
# payments).
#
# Defaults are deliberately generous rather than tight: a large share of
# Colombian retail traffic is mobile, where carrier-grade NAT puts many
# unrelated shoppers behind one public address, so a limit sized as though one
# IP meant one person would reject real customers during exactly the traffic
# spike a merchant most wants. Raise these if a deployment sits behind an
# unusually large shared address; lower them only with that in mind.
# RATE_LIMIT_AUTH_PER_MINUTE=60
# RATE_LIMIT_CHECKOUT_PER_MINUTE=60
# RATE_LIMIT_WEBHOOKS_PER_MINUTE=600
# RATE_LIMIT_AGENT_PER_MINUTE=30

# --- AI sales agent (docs/SPEC.md §7) ----------------------------------------
# Required for the agent to answer at all, on the web widget and on WhatsApp.
# Without it the API still boots and serves the catalogue — the client is
# constructed lazily and fails at the first agent request, which is the right
# place for that to surface (a store with no AI traffic should not be unable to
# sell).
ANTHROPIC_API_KEY=

# --- Platform operator access (SPEC.md §6, M9) -------------------------------
# Comma-separated emails allowed to reach /v1/platform/* — the VENTIA operator
# surface, not a merchant's.
#
# UNSET MEANS NOBODY. The guard builds an empty allowlist and denies everyone,
# which is deliberate: the grant lives here rather than in a database row
# because no HTTP request writes process.env, whereas Membership rows are
# already produced by the merchant-facing staff-invite path.
#
# The listed address must ALSO have a verified email. That is not decoration —
# auth.ts sets requireEmailVerification: false, so anyone can sign up as an
# address they do not own and hold a session immediately; without the
# verification check, registering ops@yourdomain before you do is a takeover.
# PLATFORM_ADMIN_EMAILS=ops@yourdomain.co

# --- Custom domains (SPEC.md §11 P6) -----------------------------------------
# Secret behind the DNS TXT verification token a merchant publishes to prove
# they control a custom domain. Falls back to PAYMENTS_ENCRYPTION_KEY when
# unset, so a single-key deployment works; set it separately if you rotate the
# payments key on a different schedule, since rotating it invalidates every
# in-flight (published-but-not-yet-verified) token.
# DOMAIN_VERIFICATION_SECRET=

# --- WhatsApp channel (SPEC.md §7 channel 2) ---------------------------------
# Nothing here. WhatsApp credentials are PER TENANT, not per deployment: each
# merchant connects their own number through Configuración -> WhatsApp, and the
# access token / app secret / verify token are encrypted per row with
# PAYMENTS_ENCRYPTION_KEY. See docs/deploying-whatsapp.md for the Meta-side
# setup, including the one platform-level decision (which Meta app the numbers
# live under) that is made in the Meta dashboard rather than here.
