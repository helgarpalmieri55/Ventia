# syntax=docker/dockerfile:1
#
# @ventia/api — NestJS 10, compiled to CommonJS by `tsc`, run under plain node.
#
# Build from the REPO ROOT, not from docker/:
#   docker build -f docker/Dockerfile.api -t ventia-api .
#
# Two targets:
#   --target runner   (default) the API process. Production dependencies only.
#   --target migrator            `prisma migrate deploy`. Carries the Prisma
#                                CLI, which is a devDependency and therefore
#                                deliberately absent from `runner`.
# compose.prod.yaml builds both.

# =============================================================================
# base — toolchain, shared by every stage below and by the other two images.
# =============================================================================
ARG NODE_IMAGE=node:22.22-bookworm-slim

# runtime-base is also the parent of `runner` and `migrator`: openssl is not a
# build convenience, it is what the Prisma query engine links against. Without
# it, `prisma generate` mis-detects the platform and emits
# libquery_engine-debian-openssl-1.1.x.so.node — an engine bookworm cannot
# load — and the failure surfaces as a cryptic engine error on the first query,
# not at build time. (Verified: dropping this line reproduces exactly that.)
FROM ${NODE_IMAGE} AS runtime-base
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

FROM runtime-base AS base
# COREPACK_HOME is not cosmetic. Corepack caches the pnpm it downloads under
# that path, defaulting to the CURRENT USER's ~/.cache — and `corepack prepare`
# below runs as root while the migrator container runs as `node`. Without a
# shared path the runtime user looks in /home/node, finds nothing, and
# re-downloads pnpm from the registry on every migration run, which fails
# outright on a host with no egress. (Observed exactly that: the first
# `compose up` of this stack died in `prisma migrate deploy` with a corepack
# TLS error before touching the database.)
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COREPACK_HOME=/pnpm/corepack \
    CI=1
WORKDIR /app

# Optional extra CA for the BUILD ONLY, for hosts that sit behind a
# TLS-terminating proxy. Supplying nothing leaves an empty file, which Node
# accepts silently — so this is a no-op on a normal machine:
#   docker build --secret id=proxy_ca,src=/path/to/ca.pem ...
# It is needed here because two build steps reach the network over HTTPS and
# both are Node clients: `next/font/google` (the other two images) and the
# Prisma engine download (this one). The secret never becomes an image layer,
# and the stage it lands in is discarded before `runner`.
RUN --mount=type=secret,id=proxy_ca,target=/tmp/proxy-ca.crt \
    mkdir -p /usr/local/share/ca-certificates \
 && if [ -s /tmp/proxy-ca.crt ]; then \
      cp /tmp/proxy-ca.crt /usr/local/share/ca-certificates/build-proxy-ca.crt; \
      chmod 0644 /usr/local/share/ca-certificates/build-proxy-ca.crt; \
    else \
      : > /usr/local/share/ca-certificates/build-proxy-ca.crt; \
    fi
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/build-proxy-ca.crt

# Pinned to the version in the root package.json's `packageManager` field.
# Corepack would honour that field anyway, but only once a manifest is in the
# image — pinning here keeps this layer independent of the manifests below.
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# =============================================================================
# fetch — the layer that exists so a code change does not re-download the world.
#
# `pnpm fetch` reads ONLY pnpm-lock.yaml and populates the pnpm content store.
# It touches no package.json, so this layer is invalidated by a dependency
# change and by nothing else. The alternative considered was `pnpm deploy
# --filter`: it produces a smaller, self-contained tree, but it resolves the
# dependency graph fresh (so `@prisma/client`'s peer-suffixed store directory
# changes and the generated client no longer matches), and in pnpm 9 it copies
# a workspace package's files through npm-packlist, which honours .gitignore —
# and `packages/*/dist` IS gitignored here, so the built output of every
# workspace package would be silently dropped. That is exactly the "stale or
# missing @ventia/db build" failure this repo warns about, so: `pnpm fetch`.
#
# Identical instructions in all three Dockerfiles, so building the second and
# third image reuses this layer rather than recomputing it.
# =============================================================================
FROM base AS fetch
COPY pnpm-lock.yaml ./
RUN pnpm fetch

# =============================================================================
# deps — resolve the workspace from manifests alone, still without any source.
# =============================================================================
FROM fetch AS deps
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json ./
# Every workspace manifest, because --frozen-lockfile verifies the lockfile
# against ALL importers and fails if one is missing — even though the filtered
# install below only materialises @ventia/api's half of the graph.
COPY packages/core/package.json      packages/core/
COPY packages/db/package.json        packages/db/
COPY packages/payments/package.json  packages/payments/
COPY packages/ui/package.json        packages/ui/
COPY packages/whatsapp/package.json  packages/whatsapp/
COPY services/api/package.json       services/api/
COPY apps/storefront/package.json    apps/storefront/
COPY apps/admin/package.json         apps/admin/
# --offline: everything is already in the store from `pnpm fetch`; if anything
# is not, fail loudly here rather than quietly reaching the network and
# producing a tree the lockfile does not describe.
RUN pnpm install --frozen-lockfile --offline --filter "@ventia/api..."

# =============================================================================
# builder — Prisma client, then every workspace package @ventia/api imports.
# =============================================================================
FROM deps AS builder
COPY packages/ packages/
COPY services/api/ services/api/

# Before `@ventia/db`'s tsc: its src imports `@prisma/client`, whose types do
# not exist until the client is generated. The generated client (and the query
# engine .node binary that ships beside it) lands inside the pnpm store entry
# for @prisma/client and must survive into `runner` — see the prune step below.
RUN pnpm --filter @ventia/db exec prisma generate

# `@ventia/api...` = the package and its workspace dependencies, in topological
# order: core -> db/payments/whatsapp -> api. This is what guarantees
# @ventia/db's dist/ (and with it tenant-models.ts's TENANT_MODELS, which the
# tenant-scoped Prisma client reads to decide what to scope) is built and
# current before the API that imports it. @ventia/ui is correctly not built
# here: nothing in services/api imports it.
RUN pnpm --filter "@ventia/api..." run build

# =============================================================================
# prod-deps — the runtime tree: lockfile-exact, production-only, API-only.
#
# This is the part of the file that is not obvious, so: pnpm's isolated virtual
# store (node_modules/.pnpm) is WORKSPACE-WIDE and built from the LOCKFILE, not
# from the workspace. `pnpm install --prod` prunes each importer's own
# node_modules but leaves the virtual store alone, so a `--prod` install here
# still ships vitest, tsx, testcontainers, supertest, typescript, the Prisma
# CLI and @next/swc's 274 MB of platform binaries — measured: a 1.82 GB image
# containing every dev dependency in the repo. Removing importers from
# pnpm-workspace.yaml changes nothing, because the lockfile is the input.
#
# `pnpm deploy --config.node-linker=hoisted` does produce a genuinely filtered
# 289 MB tree, and was the first choice — but it RE-RESOLVES the dependency
# graph against the registry and honours neither --frozen-lockfile nor
# --offline (the latter fails outright with ERR_PNPM_NO_OFFLINE_META). Measured
# against this lockfile it pulled 51 packages the lockfile does not pin,
# including @aws-sdk/client-s3@3.1113.0 in place of the locked build and the
# whole @better-auth/* set at 1.7.1. An image whose dependency versions were
# chosen at build time rather than by the lockfile is an image nobody tested,
# which on a platform that moves money is the wrong half of the trade.
#
# So the install stays lockfile-exact and the virtual store is pruned by
# reachability instead. See the script below for why peer links are excluded.
# =============================================================================
FROM builder AS prod-deps

# The generated Prisma client lives inside the store entry for @prisma/client
# as a plain `.prisma` directory that no manifest mentions — pnpm has no reason
# to preserve it across an install, and regenerating afterwards is impossible
# because the CLI is the devDependency being removed. tar rather than cp: the
# tree is full of symlinks into the store.
#
# --ignore-scripts for the same reason: @prisma/client's postinstall re-runs
# `prisma generate`.
RUN tar -cf /tmp/prisma-client.tar node_modules/.pnpm/@prisma+client@*/node_modules/.prisma \
 && pnpm install --frozen-lockfile --offline --prod --ignore-scripts \
 && tar -xf /tmp/prisma-client.tar \
 && rm /tmp/prisma-client.tar

# The two Next.js apps are not part of this image and must not anchor anything
# in the store — `next` and `react` are their PRODUCTION dependencies, so
# leaving apps/ here would keep all 274 MB of @next/swc reachable.
RUN rm -rf apps

RUN <<'PRUNE'
set -e
node - <<'JS'
// Prune the workspace-wide virtual store to what @ventia/api can actually
// reach. Seeds are every symlink in the workspace outside node_modules/.pnpm
// (i.e. the importers' resolved dependencies); the closure then follows, from
// each surviving store entry, the links naming that package's own
// `dependencies` / `optionalDependencies`.
//
// Peer links are deliberately NOT followed. pnpm materialises a link for every
// peer, including optional ones, so following them keeps typescript, the
// Prisma CLI, vitest and next alive inside a "production" tree — that single
// distinction is the difference between 989 MB and 269 MB here. It is safe by
// the peer contract: a peer a package genuinely needs is supplied by whoever
// depends on it, and is therefore already reachable from that importer.
const fs = require('node:fs'), path = require('node:path');
const root = '/app', store = path.join(root, 'node_modules', '.pnpm');
const keep = new Set(), pending = [];

const note = (target) => {
  if (!target.startsWith(store + path.sep)) return;
  const entry = target.slice(store.length + 1).split(path.sep)[0];
  if (entry && entry !== 'node_modules' && !keep.has(entry)) { keep.add(entry); pending.push(entry); }
};
const follow = (p) => { try { note(fs.realpathSync(p)); } catch {} };

const scanSeeds = (dir, depth) => {
  if (depth > 10) return;
  let ents; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
  for (const e of ents) {
    const p = path.join(dir, e.name);
    if (p === store) continue;
    if (e.isSymbolicLink()) follow(p);
    else if (e.isDirectory()) scanSeeds(p, depth + 1);
  }
};

// Inside <entry>/node_modules the package itself is the only real directory
// (besides .bin); everything else is a link to another store entry.
const ownManifest = (nm) => {
  let ents; try { ents = fs.readdirSync(nm, { withFileTypes: true }); } catch { return null; }
  for (const e of ents) {
    if (e.isSymbolicLink() || !e.isDirectory() || e.name === '.bin') continue;
    if (!e.name.startsWith('@')) return path.join(nm, e.name);
    let subs; try { subs = fs.readdirSync(path.join(nm, e.name), { withFileTypes: true }); } catch { continue; }
    for (const s of subs) if (!s.isSymbolicLink() && s.isDirectory()) return path.join(nm, e.name, s.name);
  }
  return null;
};

const expand = (entry) => {
  const nm = path.join(store, entry, 'node_modules');
  const own = ownManifest(nm);
  if (!own) return;
  let pj; try { pj = JSON.parse(fs.readFileSync(path.join(own, 'package.json'), 'utf8')); } catch { return; }
  const wanted = new Set([
    ...Object.keys(pj.dependencies || {}),
    ...Object.keys(pj.optionalDependencies || {}),
  ]);
  const followNamed = (dir, prefix) => {
    let ents; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
    for (const e of ents) {
      const p = path.join(dir, e.name);
      if (!prefix && e.name.startsWith('@') && e.isDirectory()) { followNamed(p, e.name); continue; }
      if (e.isSymbolicLink() && wanted.has(prefix ? `${prefix}/${e.name}` : e.name)) follow(p);
    }
  };
  followNamed(nm, '');
};

scanSeeds(root, 0);
while (pending.length) expand(pending.pop());

let removed = 0;
for (const entry of fs.readdirSync(store)) {
  if (entry === 'node_modules' || entry === 'lock.yaml' || keep.has(entry)) continue;
  fs.rmSync(path.join(store, entry), { recursive: true, force: true });
  removed++;
}

// pnpm links every package into .pnpm/node_modules as a fallback for packages
// with undeclared dependencies. Links to entries just removed now dangle; drop
// them so such a require fails loudly instead of resolving to a partial tree.
let dangling = 0;
const sweep = (dir) => {
  let ents; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
  for (const e of ents) {
    const p = path.join(dir, e.name);
    if (e.isSymbolicLink()) { if (!fs.existsSync(p)) { fs.rmSync(p, { force: true }); dangling++; } }
    else if (e.isDirectory()) sweep(p);
  }
};
sweep(path.join(store, 'node_modules'));

console.log(`virtual store: kept ${keep.size}, removed ${removed}, dangling hoist links removed ${dangling}`);
JS
PRUNE

# Everything above is asserted, not assumed — the first draft of this file
# shipped all four of these and looked fine.
RUN for p in vitest tsx testcontainers supertest typescript prisma next turbo; do \
      if ls -d node_modules/.pnpm/"$p"@* >/dev/null 2>&1; then \
        echo "dev dependency $p survived into the runtime tree"; exit 1; fi; \
    done \
 && if ls -d node_modules/.pnpm/@next+swc* >/dev/null 2>&1; then echo "@next/swc survived"; exit 1; fi \
 && echo "no dev dependencies in the runtime tree"

# Fail the BUILD, not the first request. Importing @ventia/db constructs a
# PrismaClient at module scope — which throws outright when the generated
# client is missing — and TENANT_MODELS is the set the tenant-scoped client
# consults to decide what to scope, so a non-zero size here is proof that
# packages/db/dist is present and current rather than a leftover from an
# earlier build. Nothing else in this image would notice a stale one.
RUN cd /app/services/api \
 && node -e "import('@ventia/db').then(m=>{if(!(m.TENANT_MODELS&&m.TENANT_MODELS.size))throw new Error('TENANT_MODELS empty');console.log('@ventia/db ok, TENANT_MODELS:',m.TENANT_MODELS.size)})" \
 && test -d /app/packages/db/prisma/migrations \
 && echo "migrations present: $(ls /app/packages/db/prisma/migrations | wc -l) entries"

# =============================================================================
# migrator — `prisma migrate deploy`, the one-shot that must succeed before the
# API starts (compose.prod.yaml enforces the ordering).
#
# `FROM builder` rather than a fresh stage that copies things in, for two
# reasons. Correctness: the migrations this applies are, by construction, the
# ones the API image was built against — there is no path by which the two can
# disagree. Disk: it adds a CMD and a USER to layers the API build already
# produced, so it costs essentially nothing on a single VPS even though
# `docker images` reports it at builder size. It keeps the Prisma CLI, which is
# a devDependency and is precisely why `runner` below asserts its absence.
# =============================================================================
FROM builder AS migrator
ENV NODE_ENV=production

# /app stays root-owned and is only read here — migrate deploy reads
# prisma/schema.prisma plus prisma/migrations and talks to Postgres; it writes
# nothing to the filesystem. Running as `node` against a tree it cannot modify
# is the stronger position, and avoids a full recursive chown of a 2 GB tree.
USER node

# `migrate deploy` is the only Prisma migration command that is safe
# unattended: it applies pending migrations in order, never prompts, never
# resets, never "fixes" drift, and exits non-zero on any failure — which is
# what compose.prod.yaml's service_completed_successfully condition reads.
CMD ["pnpm", "--filter", "@ventia/db", "migrate:deploy"]

# =============================================================================
# runner — the API process itself.
# =============================================================================
FROM runtime-base AS runner
ENV NODE_ENV=production
WORKDIR /app

# `node` (uid 1000) already exists in the base image; /app is owned by it so
# nothing runs as root, and nothing in the API writes to disk (compose.prod.yaml
# mounts the filesystem read-only on the strength of that).
#
# packages/db/prisma/{schema.prisma,migrations} is copied deliberately: the
# migrations that ship with an image must be the ones that image was built
# against, so `docker run --entrypoint ...` against this image can always be
# used to inspect or, with the `migrator` target, apply exactly them.
COPY --from=prod-deps --chown=node:node /app/node_modules        /app/node_modules
COPY --from=prod-deps --chown=node:node /app/package.json        /app/package.json
COPY --from=prod-deps --chown=node:node /app/pnpm-workspace.yaml /app/pnpm-workspace.yaml
COPY --from=prod-deps --chown=node:node /app/packages            /app/packages
COPY --from=prod-deps --chown=node:node /app/services/api        /app/services/api

USER node

# API_PORT is read at RUNTIME by loadEnv() (packages/core/src/env.ts), so this
# is documentation for `docker inspect`, not a value baked into anything.
EXPOSE 4000

# Nest's shutdown hooks (app.enableShutdownHooks() in main.ts) and the
# SIGTERM/SIGINT handlers that flush Sentry mean node-as-PID-1 shuts down
# cleanly; compose.prod.yaml sets `init: true` for zombie reaping regardless.
#
# `node dist/main.js`, not `tsx src/main.ts`: tsx is a devDependency, it
# recompiles on every boot, and it is asserted absent from this image.
CMD ["node", "services/api/dist/main.js"]
